# Local database contents, accounts, and session signing key
*.db
*.sqlite
*.sqlite3
.session_key

# Local secrets and environment-specific configuration
.env
.env.*
!.env.example
config/*
!config/.gitkeep
!config/thresholds.example.yaml

# Python cache and virtual environments
__pycache__/
*.py[cod]
.venv/
venv/

# Local runtime logs
*.log
